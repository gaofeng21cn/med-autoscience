{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opl.onepersonlab/contracts/mas-study-initialization-authority.output.schema.json",
  "title": "MAS first-use study initialization authority result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "schema_version",
    "status",
    "initialization_receipt",
    "mas_lifecycle_cas_mutation_authorization",
    "opl_host_materialization_request",
    "typed_blocker",
    "error",
    "authority_boundary",
    "decision_id",
    "decision_fingerprint"
  ],
  "properties": {
    "surface_kind": {
      "const": "mas_study_initialization_authority_result"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "authorized",
        "typed_blocker",
        "invalid_host_input"
      ]
    },
    "initialization_receipt": {
      "oneOf": [
        {
          "$ref": "#/$defs/initialization_receipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "mas_lifecycle_cas_mutation_authorization": {
      "oneOf": [
        {
          "$ref": "#/$defs/authorization"
        },
        {
          "type": "null"
        }
      ]
    },
    "opl_host_materialization_request": {
      "oneOf": [
        {
          "$ref": "#/$defs/host_request"
        },
        {
          "type": "null"
        }
      ]
    },
    "typed_blocker": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_truth_owner": {
          "const": "MedAutoScience"
        },
        "host_materialization_owner": {
          "const": "one-person-lab"
        },
        "performs_filesystem_io": {
          "const": false
        },
        "performs_network_io": {
          "const": false
        },
        "persists_artifact_or_receipt": {
          "const": false
        },
        "quality_verdict_created": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "submission_authorized": {
          "const": false
        },
        "handler_result_alone_is_launch_clearance": {
          "const": false
        }
      },
      "required": [
        "domain_truth_owner",
        "host_materialization_owner",
        "performs_filesystem_io",
        "performs_network_io",
        "persists_artifact_or_receipt",
        "quality_verdict_created",
        "publication_authorized",
        "submission_authorized",
        "handler_result_alone_is_launch_clearance"
      ]
    },
    "decision_id": {
      "type": "string",
      "pattern": "^mas-study-initialization-decision:[a-f0-9]{64}$"
    },
    "decision_fingerprint": {
      "$ref": "#/$defs/prefixed_sha256"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "file_url": {
      "type": "string",
      "pattern": "^file:///.+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
    },
    "prefixed_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "workspace_relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_kind",
        "version",
        "capability_id",
        "request_id",
        "domain_id",
        "operations_sha256",
        "materialization_scope_sha256",
        "absent_relative_path_preconditions",
        "authorized",
        "authority_receipt_ref",
        "satisfied_gate_ids",
        "authorization_ref",
        "authorization_fingerprint"
      ],
      "properties": {
        "surface_kind": {
          "const": "mas_lifecycle_cas_mutation_authorization"
        },
        "version": {
          "const": "mas-lifecycle-cas-mutation-authorization.v1"
        },
        "capability_id": {
          "const": "opl_domain_artifact_cas_materialization.v1"
        },
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "domain_id": {
          "const": "medautoscience"
        },
        "operations_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "materialization_scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "absent_relative_path_preconditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workspace_relative_path"
          }
        },
        "authorized": {
          "const": true
        },
        "authority_receipt_ref": {
          "$ref": "#/$defs/text"
        },
        "satisfied_gate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^mas-lifecycle-cas-authorization:[a-f0-9]{64}$"
        },
        "authorization_fingerprint": {
          "$ref": "#/$defs/prefixed_sha256"
        }
      }
    },
    "host_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_kind",
        "version",
        "capability_id",
        "request_id",
        "domain_id",
        "authorization_ref",
        "operations_sha256",
        "materialization_scope_sha256",
        "absent_relative_path_preconditions",
        "operations"
      ],
      "properties": {
        "surface_kind": {
          "const": "opl_domain_artifact_cas_materialization_request"
        },
        "version": {
          "const": "opl-domain-artifact-cas-materialization.v1"
        },
        "capability_id": {
          "const": "opl_domain_artifact_cas_materialization.v1"
        },
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "domain_id": {
          "const": "medautoscience"
        },
        "authorization_ref": {
          "$ref": "#/$defs/text"
        },
        "operations_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "materialization_scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "absent_relative_path_preconditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workspace_relative_path"
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_relative_path",
        "precondition",
        "replacement_bytes_base64",
        "replacement_sha256",
        "replacement_byte_size"
      ],
      "properties": {
        "target_relative_path": {
          "$ref": "#/$defs/text"
        },
        "precondition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sha256",
                "byte_size"
              ],
              "properties": {
                "kind": {
                  "const": "existing_exact"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "byte_size": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "absent"
                }
              }
            }
          ]
        },
        "replacement_bytes_base64": {
          "type": "string",
          "minLength": 1
        },
        "replacement_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "replacement_byte_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "initialization_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_kind",
        "schema_version",
        "owner",
        "study_id",
        "handler_call_ref",
        "owner_ledger_ref",
        "original_admission_request_ref",
        "original_admission_request_sha256",
        "admission_scope_id",
        "requested_action_id",
        "requested_run_id",
        "original_invocation_sha256",
        "requested_at",
        "inventory_ref",
        "inventory_sha256",
        "from_state",
        "from_generation",
        "to_state",
        "to_generation",
        "lifecycle_ref",
        "lifecycle_sha256",
        "stage_body_authorized",
        "publication_authorized",
        "submission_authorized",
        "quality_verdict_created",
        "requires_opl_cas_materialization_receipt",
        "materialization_semantics",
        "receipt_ref",
        "receipt_fingerprint"
      ],
      "properties": {
        "receipt_kind": {
          "const": "mas_study_initialization_receipt"
        },
        "schema_version": {
          "const": 1
        },
        "owner": {
          "const": "MedAutoScience"
        },
        "study_id": {
          "$ref": "#/$defs/text"
        },
        "handler_call_ref": {
          "$ref": "#/$defs/text"
        },
        "owner_ledger_ref": {
          "$ref": "#/$defs/file_url"
        },
        "original_admission_request_ref": {
          "$ref": "#/$defs/file_url"
        },
        "original_admission_request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "admission_scope_id": {
          "$ref": "#/$defs/text"
        },
        "requested_action_id": {
          "$ref": "#/$defs/text"
        },
        "requested_run_id": {
          "$ref": "#/$defs/text"
        },
        "original_invocation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "inventory_ref": {
          "const": "workspace_index.json"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "from_state": {
          "const": "uninitialized"
        },
        "from_generation": {
          "const": 0
        },
        "to_state": {
          "const": "active"
        },
        "to_generation": {
          "const": 1
        },
        "lifecycle_ref": {
          "$ref": "#/$defs/workspace_relative_path"
        },
        "lifecycle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stage_body_authorized": {
          "const": true
        },
        "publication_authorized": {
          "const": false
        },
        "submission_authorized": {
          "const": false
        },
        "quality_verdict_created": {
          "const": false
        },
        "requires_opl_cas_materialization_receipt": {
          "const": true
        },
        "materialization_semantics": {
          "const": "journaled_all_or_rollback"
        },
        "receipt_ref": {
          "type": "string",
          "pattern": "^mas-study-initialization:[a-f0-9]{64}$"
        },
        "receipt_fingerprint": {
          "$ref": "#/$defs/prefixed_sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "authorized"
          }
        }
      },
      "then": {
        "properties": {
          "initialization_receipt": {
            "$ref": "#/$defs/initialization_receipt"
          },
          "mas_lifecycle_cas_mutation_authorization": {
            "$ref": "#/$defs/authorization"
          },
          "opl_host_materialization_request": {
            "$ref": "#/$defs/host_request"
          },
          "typed_blocker": {
            "type": "null"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "initialization_receipt": {
            "type": "null"
          },
          "mas_lifecycle_cas_mutation_authorization": {
            "type": "null"
          },
          "opl_host_materialization_request": {
            "type": "null"
          }
        }
      }
    }
  ]
}
