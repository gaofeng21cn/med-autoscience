{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opl.onepersonlab/contracts/mas-workspace-index.schema.json",
  "title": "MAS workspace study inventory compatibility schema",
  "description": "Non-enforcing compatibility definition for MAS-owned study inventory rows. OPL initialization may create identity-only rows with study_id and canonical_study_root; MAS lifecycle authority adds business status, stage, package, and lifecycle fields when those truths exist. The schema allows host envelope extensions and does not declare host enforcement.",
  "$comment": "The stable domain identity remains study_id. Structural initialization is not a lifecycle or publication verdict, and absent MAS-owned lifecycle fields must remain absent rather than be inferred by a host.",
  "type": "object",
  "additionalProperties": true,
  "required": ["surface_kind", "studies"],
  "oneOf": [
    {
      "required": ["schema_version"],
      "not": { "required": ["version"] },
      "properties": {
        "surface_kind": { "const": "workspace_index" },
        "schema_version": { "const": "mas.workspace_index.v1" }
      }
    },
    {
      "required": ["version"],
      "not": { "required": ["schema_version"] },
      "properties": {
        "surface_kind": { "const": "opl_workspace_index" },
        "version": { "const": "workspace-index.v1" }
      }
    }
  ],
  "properties": {
    "surface_kind": {
      "enum": ["workspace_index", "opl_workspace_index"]
    },
    "schema_version": {
      "const": "mas.workspace_index.v1"
    },
    "version": {
      "const": "workspace-index.v1"
    },
    "studies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/study"
      }
    }
  },
  "$defs": {
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "non_empty_text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "nullable_non_empty_text": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/non_empty_text"
        }
      ]
    },
    "workspace_relative_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "canonical_study_root": {
      "type": "string",
      "pattern": "^studies/[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "study": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "study_id",
        "canonical_study_root"
      ],
      "properties": {
        "study_id": {
          "$ref": "#/$defs/study_id"
        },
        "canonical_study_root": {
          "$ref": "#/$defs/canonical_study_root"
        },
        "display_name": {
          "$ref": "#/$defs/non_empty_text"
        },
        "status": {
          "$ref": "#/$defs/non_empty_text"
        },
        "current_stage_id": {
          "$ref": "#/$defs/nullable_non_empty_text"
        },
        "current_stage_status": {
          "$ref": "#/$defs/nullable_non_empty_text"
        },
        "package_status": {
          "$ref": "#/$defs/non_empty_text"
        },
        "lifecycle_ref": {
          "$ref": "#/$defs/workspace_relative_ref"
        },
        "stage_index_ref": {
          "$ref": "#/$defs/workspace_relative_ref"
        }
      }
    }
  }
}
