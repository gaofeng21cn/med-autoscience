#!/usr/bin/env python3
"""Serve read-only MAS App contributions from the selected study workspace."""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path
from typing import Any


REQUEST_SCHEMA = "opl-package-app-contribution-request.v1"
RESPONSE_SCHEMA = "opl-package-app-contribution-response.v1"
DATA_REF = "mas.runtime-detail.v1#current"
STUDY_ID_PATTERN = re.compile(r"^[a-z0-9]+(?:[._-][a-z0-9]+)*$")


class ContributionError(ValueError):
    """Fail-closed request or source error."""


def _record(value: Any, field: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ContributionError(f"{field} must be an object")
    return value


def _text(value: Any, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ContributionError(f"{field} must be a non-empty string")
    return value.strip()


def _load_json(path: Path, field: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ContributionError(f"{field} is unavailable or invalid") from error
    return _record(value, field)


def _workspace_root() -> Path:
    raw = os.environ.get("OPL_PROFILE_WORKSPACE", "")
    if not raw.strip():
        raise ContributionError("OPL_PROFILE_WORKSPACE is required")
    root = Path(raw).expanduser().resolve()
    if not root.is_dir():
        raise ContributionError("OPL_PROFILE_WORKSPACE must resolve to a directory")
    return root


def _identity(request: dict[str, Any]) -> dict[str, str]:
    identity = _record(
        _record(request.get("input"), "input").get("work_item_identity"),
        "input.work_item_identity",
    )
    expected = {
        "agent_id": "mas",
        "domain_id": "medautoscience",
        "identity_state": "resolved",
    }
    for field, value in expected.items():
        if identity.get(field) != value:
            raise ContributionError(
                f"input.work_item_identity.{field} must equal {value}"
            )
    work_item_id = _text(
        identity.get("work_item_id"),
        "input.work_item_identity.work_item_id",
    )
    if not STUDY_ID_PATTERN.fullmatch(work_item_id):
        raise ContributionError("input.work_item_identity.work_item_id is invalid")
    if identity.get("domain_work_item_id") != work_item_id:
        raise ContributionError(
            "input.work_item_identity.domain_work_item_id must equal work_item_id"
        )
    scope_id = _text(
        identity.get("work_item_scope_id"),
        "input.work_item_identity.work_item_scope_id",
    )
    return {
        "agent_id": "mas",
        "domain_id": "medautoscience",
        "work_item_id": work_item_id,
        "domain_work_item_id": work_item_id,
        "work_item_scope_id": scope_id,
        "identity_state": "resolved",
    }


def _study(index: dict[str, Any], work_item_id: str) -> dict[str, Any]:
    studies = index.get("studies")
    if not isinstance(studies, list):
        raise ContributionError("workspace_index.json studies must be an array")
    matches = [
        item
        for item in studies
        if isinstance(item, dict) and item.get("study_id") == work_item_id
    ]
    if len(matches) != 1:
        raise ContributionError("work_item_id must match exactly one workspace study")
    study = matches[0]
    expected_root = f"studies/{work_item_id}"
    if study.get("canonical_study_root") != expected_root:
        raise ContributionError("workspace study root does not match work_item_id")
    return study


def _work(study: dict[str, Any]) -> dict[str, Any]:
    current_stage_id = study.get("current_stage_id")
    current_stage_status = study.get("current_stage_status")
    next_action = study.get("next_action")
    active = []
    if isinstance(current_stage_id, str) and current_stage_id.strip():
        active.append(
            {
                "stage_id": current_stage_id,
                "status": current_stage_status,
            }
        )
    queued = []
    pending = []
    if isinstance(next_action, dict):
        status = next_action.get("status")
        if status == "queued":
            queued.append(next_action)
        elif status not in {None, "completed"}:
            pending.append(next_action)
    return {"active": active, "queued": queued, "pending": pending}


def _hypotheses(trajectory: dict[str, Any]) -> list[dict[str, Any]]:
    nodes = trajectory.get("nodes")
    if not isinstance(nodes, list):
        raise ContributionError("research trajectory nodes must be an array")
    return [
        {
            "hypothesis_id": node.get("id"),
            "status": node.get("status"),
            "label": node.get("label"),
            "summary": node.get("summary"),
        }
        for node in nodes
        if isinstance(node, dict) and node.get("kind") == "hypothesis"
    ]


def _result(identity: dict[str, str]) -> dict[str, Any]:
    root = _workspace_root()
    index = _load_json(root / "workspace_index.json", "workspace_index.json")
    study = _study(index, identity["work_item_id"])
    trajectory_ref = (
        Path(str(study["canonical_study_root"]))
        / "artifacts/research_trajectory/snapshot.json"
    )
    trajectory = _load_json(root / trajectory_ref, str(trajectory_ref))
    if trajectory.get("study_id") != identity["work_item_id"]:
        raise ContributionError("research trajectory study_id does not match work_item_id")
    if trajectory.get("study_ref") != {
        "kind": "mas_study",
        "ref": f"mas-study:{identity['work_item_id']}",
    }:
        raise ContributionError("research trajectory study_ref does not match work_item_id")

    next_action = study.get("next_action")
    current_owner = next_action.get("owner") if isinstance(next_action, dict) else None
    summary = _record(trajectory.get("summary"), "research trajectory summary")
    return {
        "surface_kind": "mas_runtime_detail_contribution",
        "version": "mas-runtime-detail-contribution.v1",
        "identity": {
            "agent_id": identity["agent_id"],
            "domain_id": identity["domain_id"],
            "work_item_id": identity["work_item_id"],
            "study_id": identity["domain_work_item_id"],
            "identity_state": identity["identity_state"],
            "scope_binding": "work_item_id_exact_study_id",
        },
        "agent": {
            "agent_id": "mas",
            "display_name": "Med Auto Science",
            "authority_owner": "MedAutoScience",
        },
        "current_owner": current_owner,
        "phase": {
            "business_status": study.get("business_status", study.get("status")),
            "lifecycle_state": study.get("lifecycle_state", study.get("status")),
            "stage_id": study.get("current_stage_id"),
            "stage_status": study.get("current_stage_status"),
        },
        "work": _work(study),
        "hypotheses": _hypotheses(trajectory),
        "roadmap": {
            "trajectory_revision": trajectory.get("revision"),
            "trajectory_status": trajectory.get("status"),
            "current_focus": trajectory.get("current_focus"),
            "active_branch": trajectory.get("active_branch"),
            "current_judgment": summary.get("current_judgment"),
            "next_research_step": summary.get("next_research_step"),
        },
        "source_refs": [
            "workspace_index.json",
            trajectory_ref.as_posix(),
        ],
        "authority_boundary": {
            "projection_only": True,
            "writes_domain_truth": False,
            "writes_runtime_state": False,
            "provider_completion_is_progress": False,
        },
    }


def main() -> int:
    request: dict[str, Any] = {}
    try:
        request = _record(json.load(sys.stdin), "request")
        if request.get("schema_version") != REQUEST_SCHEMA:
            raise ContributionError("request schema_version is unsupported")
        if request.get("operation") != "read":
            raise ContributionError("only read is supported")
        if request.get("ref") != DATA_REF:
            raise ContributionError("contribution ref is unsupported")
        response = {
            "schema_version": RESPONSE_SCHEMA,
            "ok": True,
            "ref": DATA_REF,
            "operation": "read",
            "result": _result(_identity(request)),
        }
        print(json.dumps(response, ensure_ascii=False, separators=(",", ":")))
        return 0
    except (ContributionError, json.JSONDecodeError) as error:
        print(
            json.dumps(
                {
                    "schema_version": RESPONSE_SCHEMA,
                    "ok": False,
                    "ref": request.get("ref") if isinstance(request, dict) else None,
                    "operation": request.get("operation")
                    if isinstance(request, dict)
                    else None,
                    "error": {
                        "code": "mas_runtime_detail_contribution_invalid",
                        "message": str(error),
                    },
                },
                ensure_ascii=False,
                separators=(",", ":"),
            )
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
