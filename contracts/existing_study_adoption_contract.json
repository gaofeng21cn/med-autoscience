{
  "surface_kind": "mas_existing_study_adoption_contract",
  "schema_version": 1,
  "contract_id": "mas.existing-study-adoption.v1",
  "owner": "MedAutoScience",
  "action_id": "study_work_item_adoption_authority_evaluate",
  "handler_ref": "handler:mas.study-work-item-adoption-authority-evaluate",
  "input_schema_ref": "contracts/schemas/v2/mas-existing-study-adoption-authority.input.schema.json",
  "output_schema_ref": "contracts/schemas/v2/mas-existing-study-adoption-authority.output.schema.json",
  "input_required_fields": [
    "surface_kind",
    "schema_version",
    "authority_context",
    "adoption_authority",
    "existing_study_identity",
    "current_mas_workspace_index",
    "current_workspace_lifecycle"
  ],
  "exact_byte_authority": {
    "user_authority_surface_kind": "mas_explicit_user_authority_evidence",
    "existing_study_evidence_surface_kind": "mas_existing_study_adoption_evidence",
    "opl_topology_surface_kind": "opl_workspace_index",
    "opl_topology_version": "workspace-index.v1",
    "raw_sha256_recomputed_by_handler": true,
    "strict_utf8_json_without_duplicate_keys": true,
    "supplied_record_must_deep_equal_exact_bytes": true
  },
  "identity_contract": {
    "existing_study_required": true,
    "qualification_identity_derivation_forbidden": true,
    "study_id_source": "exact_existing_study_identity_and_evidence",
    "canonical_study_root_template": "studies/{study_id}",
    "opl_topology_project_id_match_required": true,
    "opl_topology_project_root_is_not_mas_canonical_study_root": true
  },
  "projection_contract": {
    "mas_inventory_target": "runtime/artifacts/mas_workspace_index/latest.json",
    "mas_inventory_surface_kind": "mas_workspace_index",
    "mas_inventory_schema_version": "mas.workspace_index.v1",
    "workspace_lifecycle_target": "runtime/artifacts/study_lifecycle_control/latest.json",
    "study_lifecycle_target_template": "studies/{study_id}/control/lifecycle.json",
    "submission_status_target_template": "studies/{study_id}/submission/STATUS.json",
    "owner_receipt_target_template": "studies/{study_id}/artifacts/controller/adoption/provisioning-receipt.json",
    "root_opl_workspace_index_is_materialization_target": false,
    "existing_exact_or_absent_projection_preconditions_required": true
  },
  "initial_lifecycle": {
    "lifecycle_state": "delivered_paused",
    "generation": 1,
    "current_stage_id": null,
    "current_stage_status": null,
    "submission_ready": false,
    "milestone_package_delivered": true,
    "explicit_user_wakeup_required": true,
    "stage_body_authorized": false
  },
  "materialization_contract": {
    "capability_id": "opl_domain_artifact_cas_materialization.v1",
    "request_output_field": "opl_host_materialization_request",
    "authorization_output_field": "mas_study_work_item_adoption_cas_mutation_authorization",
    "receipt_output_field": "adoption_receipt",
    "receipt_content_binding_output_field": "adoption_receipt_content_binding",
    "materialization_semantics": "journaled_all_or_rollback",
    "single_use": true,
    "partial_commit_allowed": false,
    "handler_performs_io": false
  },
  "authority_boundary": {
    "authorizes_lifecycle_initialization": true,
    "authorizes_stage_body": false,
    "authorizes_business_action": false,
    "authorizes_publication": false,
    "authorizes_submission": false,
    "provider_completion_is_domain_completion": false,
    "public_action": false
  }
}
